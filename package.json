{
  "name": "oasis-monorepo",
  "packageManager": "pnpm@9.13.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "release:check-secrets": "bash scripts/release/check-secrets-parity.sh",
    "release:mobile-smoke": "node scripts/release/mobile-route-smoke.mjs",
    "release:staging:reliability": "node scripts/release/run-staging-reliability-suite.mjs",
    "release:readiness-report": "node scripts/release/generate-readiness-report.mjs",
    "test:browser:accessibility": "node --test tests/browser/fixtures/accessibility-api.test.mjs && playwright test --config playwright.accessibility.config.ts",
    "test:browser:linked-carer": "pnpm test:browser:accessibility && pnpm --filter @oasis/db exec prisma generate && node scripts/test/seed-linked-carer-browser.mjs && playwright test --config playwright.linked-carer.config.ts",
    "test:browser:clerk-tenant-auth": "node --test scripts/test/assert-safe-test-database.test.mjs && pnpm --filter @oasis/db exec prisma generate && node scripts/test/seed-linked-carer-browser.mjs && node scripts/test/convert-linked-carer-seed-to-clerk.mjs && playwright test --config playwright.clerk-tenant-auth.config.ts",
    "tenant:nullability:dry-run:local": "pnpm --filter @oasis/db exec prisma generate && node scripts/release/tenant-nullability-dry-run.mjs",
    "deploy:v2:preflight": "node deploy/v2/scripts/preflight-env.mjs",
    "deploy:v2:verify": "bash deploy/v2/scripts/verify-local.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^20.0.0",
    "eslint": "^8.56.0",
    "jest-junit": "^16.0.0",
    "playwright": "^1.54.2",
    "prettier": "^3.2.0",
    "testcontainers": "10.4.0",
    "ts-node": "10.9.2",
    "tsx": "^4.20.6",
    "turbo": "^2.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/graphql@13.4.2>ws": "8.21.0",
      "subscriptions-transport-ws@0.11.0>ws": "7.5.11"
    }
  },
  "dependencies": {
    "@types/pino-http": "^6.1.0",
    "@types/uuid": "^10.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "crypto-random-string": "^5.0.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0"
  }
}
