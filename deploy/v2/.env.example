# Oasis Care Deployment V2 environment template.
# Copy to deploy/v2/.env on the server and replace every <...> placeholder.
# Never commit deploy/v2/.env or real secret values.
#
# Before real client data:
# - choose a UK/EU hosting region where possible;
# - complete a provider DPA;
# - complete DPIA/security review;
# - configure Clerk production/staging auth and organisation claims.

# Public domain and HTTPS
APP_DOMAIN=<app.example.com>
ACME_EMAIL=<ops@example.com>

# Database
POSTGRES_DB=oasis
POSTGRES_USER=oasis
POSTGRES_PASSWORD=<replace-with-strong-postgres-password>
DATABASE_URL=postgresql://oasis:<replace-with-strong-postgres-password>@postgres:5432/oasis

# API/Web URLs
NEXTAUTH_URL=https://<app.example.com>
NEXT_PUBLIC_SITE_URL=https://<app.example.com>
NEXT_PUBLIC_API_URL=https://<app.example.com>/graphql
ALLOWED_ORIGINS=https://<app.example.com>

# Internal container ports. Caddy is the only public listener.
API_PORT=4000
WEB_PORT=3000

# Secrets
JWT_SECRET=<replace-with-strong-jwt-secret-min-32-chars>
NEXTAUTH_SECRET=<replace-with-strong-nextauth-secret-min-32-chars>
SHIFT_IDEMPOTENCY_HMAC_CURRENT_KEY_ID=<lowercase-key-id>
SHIFT_IDEMPOTENCY_HMAC_CURRENT_SECRET=<base64-encoded-random-secret-min-32-bytes>
SHIFT_IDEMPOTENCY_HMAC_PREVIOUS_KEYS_JSON=[]
VISIT_COMPLETION_PROOF_ACTIVE_KEY_ID=<replace-with-stable-key-id>
VISIT_COMPLETION_PROOF_ACTIVE_SECRET=<replace-with-strong-stable-secret-min-32-chars>
# Set both previous values only while completing a controlled key rotation.
VISIT_COMPLETION_PROOF_PREVIOUS_KEY_ID=
VISIT_COMPLETION_PROOF_PREVIOUS_SECRET=

# Production auth provider.
# Issue #10 makes Clerk the intended production auth provider. Keep local auth
# disabled in production, and do not use real client data until live Clerk
# staff/family sessions have passed CareBridge boundary QA.
AUTH_IDENTITY_PROVIDER=clerk
LOCAL_AUTH_ENABLED=false
NEXT_PUBLIC_LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_ISSUER=oasis-local-dev
LOCAL_AUTH_JWT_SECRET=<unused-when-local-auth-disabled>

# Clerk backend JWT verification.
CLERK_ISSUER=<replace-with-clerk-issuer>
CLERK_JWKS_URL=<replace-with-clerk-jwks-url>
CLERK_AUDIENCE=<replace-with-api-audience-or-use-authorized-parties>
CLERK_AUTHORIZED_PARTIES=<replace-with-https-app-origin>
CLERK_SECRET_KEY=<replace-with-clerk-secret-key>
PLATFORM_OPERATOR_CLERK_ORGANIZATION_ID=<replace-with-dedicated-platform-operator-clerk-org-id>
PLATFORM_OPERATOR_CLERK_SUBJECTS=<replace-with-comma-separated-exact-clerk-user-ids>

# Clerk frontend configuration. Only NEXT_PUBLIC_* values may be exposed to the browser.
NEXT_PUBLIC_AUTH_IDENTITY_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<replace-with-clerk-publishable-key>
# One exact Clerk FAPI HTTPS origin. Do not use a wildcard, path, query, or fragment.
NEXT_PUBLIC_CLERK_CSP_ORIGINS=https://<clerk-fapi.example.com>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=<replace-with-clerk-sign-in-url>
NEXT_PUBLIC_CLERK_SIGN_UP_URL=<replace-with-clerk-sign-up-url>
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=https://<app.example.com>/today
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=https://<app.example.com>/today

# Feature flags
GDPR_ENABLED=false
METRICS_ENABLED=false
AI_SUMMARY_ENABLED=false
DEMO_MODE=false

# Migrations are opt-in so container restart does not mutate the database by accident.
RUN_MIGRATIONS=false
