{
	email {$ACME_EMAIL:admin@example.com}
}

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Health, GraphQL, and API traffic stay internal and route to the API.
	handle /health {
		reverse_proxy api:4000
	}

	handle /ready {
		reverse_proxy api:4000
	}

	handle /graphql {
		reverse_proxy api:4000
	}

	handle /stats/* {
		reverse_proxy api:4000
	}

	handle /api/graphql {
		uri strip_prefix /api
		reverse_proxy api:4000
	}

	# CareBridge access boundaries are validated by deployment smoke tests, not by
	# Caddy routing. Family-safe projections must stay enforced in app/API auth.
	handle {
		reverse_proxy web:3000
	}
}
